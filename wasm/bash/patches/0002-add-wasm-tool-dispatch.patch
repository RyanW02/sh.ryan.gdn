+/* --- Browser PoC: dispatch to a separately-compiled WASM tool module. ---
+   There is no real fork()/exec() under WebAssembly (Emscripten's libc
+   stubs both to ENOSYS/ENOEXEC, and that's not going to change), so a
+   small, explicitly-curated set of external tools is run via a
+   posix_spawn-style substitute instead: a JS-side Asyncify bridge
+   (wasm_exec_tool, implemented in wasm/bash/wasm-tool-bridge.js) that
+   loads and runs a *different* compiled module to completion and hands
+   back its exit status, called as an ordinary (if slow) C function --
+   see wasm/bash/README.md ("External tools") for the full design.
+
+   Which commands this applies to is discovered the same way bash finds
+   any other command: a real, normally-PATH-searched file (seeded into
+   /usr/bin by the frontend at startup) with the executable bit set, so
+   `type`/`command -v`/`ls /usr/bin` all see these as real binaries. What
+   distinguishes a WASM-tool stub from a real external command is purely
+   its content: a one-line marker, `#!wasmtool <name>`, checked by
+   wasm_tool_stub_name() right after execute_disk_command's own
+   search_for_command() resolves a path -- deliberately *not* a hardcoded
+   name list in C, so adding a new tool never requires touching bash's
+   source (just compiling it and registering it in the frontend). */
+
+#define WASM_TOOL_MARKER "#!wasmtool "
+#define WASM_TOOL_MARKER_LEN (sizeof (WASM_TOOL_MARKER) - 1)
+
+static char *
+wasm_tool_stub_name (const char *path)
+{
+  int fd, n;
+  char buf[128];
+  char *name, *nl;
+  size_t len;
+
+  fd = open (path, O_RDONLY);
+  if (fd < 0)
+    return ((char *)NULL);
+  n = read (fd, buf, sizeof (buf) - 1);
+  close (fd);
+
+  if (n <= 0 || (size_t)n <= WASM_TOOL_MARKER_LEN)
+    return ((char *)NULL);
+  buf[n] = '\0';
+  if (strncmp (buf, WASM_TOOL_MARKER, WASM_TOOL_MARKER_LEN) != 0)
+    return ((char *)NULL);
+
+  name = buf + WASM_TOOL_MARKER_LEN;
+  nl = strchr (name, '\n');
+  if (nl)
+    *nl = '\0';
+  len = strlen (name);
+  while (len > 0 && (name[len - 1] == ' ' || name[len - 1] == '\t' || name[len - 1] == '\r'))
+    name[--len] = '\0';
+  if (len == 0)
+    return ((char *)NULL);
+
+  return (savestring (name));
+}
+
+extern int wasm_exec_tool (const char *, char **, const char *, int);
+
+static int
+execute_wasm_tool_command (WORD_LIST *words, const char *tool_name, REDIRECT *redirects)
+{
+  int result, need_stdin, stdin_len, stdin_cap, n;
+  char **argv;
+  char *stdin_buf;
+  char chunk[4096];
+
+  if (do_redirections (redirects, RX_ACTIVE|RX_UNDOABLE) != 0)
+    {
+      undo_partial_redirects ();
+      dispose_exec_redirects ();
+      return (EX_REDIRFAIL);
+    }
+
+  /* Only drain real stdin when there's an explicit `<' redirect, i.e. fd 0
+     is a regular MEMFS file (never the live pty) -- that keeps this a
+     plain, non-blocking read loop with no interaction with bash's own
+     Asyncify-based fd_read wrapping. Interactive stdin for a wasm tool
+     (no redirect at all) is not supported in this milestone. */
+  need_stdin = stdin_redirects (redirects) != 0;
+  stdin_buf = (char *)NULL;
+  stdin_len = 0;
+
+  if (need_stdin)
+    {
+      stdin_cap = 4096;
+      stdin_buf = (char *)xmalloc (stdin_cap);
+      while ((n = read (0, chunk, sizeof (chunk))) > 0)
+	{
+	  if (stdin_len + n > stdin_cap)
+	    {
+	      stdin_cap = (stdin_len + n) * 2;
+	      stdin_buf = (char *)xrealloc (stdin_buf, stdin_cap);
+	    }
+	  memcpy (stdin_buf + stdin_len, chunk, n);
+	  stdin_len += n;
+	}
+    }
+
+  argv = strvec_from_word_list (words, 0, 0, (int *)NULL);
+
+  result = wasm_exec_tool (tool_name, argv, stdin_buf, stdin_len);
+
+  strvec_dispose (argv);
+  if (stdin_buf)
+    free (stdin_buf);
+
+  fflush (stdout);
+
+  undo_partial_redirects ();
+  dispose_exec_redirects ();
+
+  return (result);
+}
+
 /* Execute a builtin or function in the current shell context.  If BUILTIN
    is non-null, it is the builtin command to execute, otherwise VAR points
    to the body of a function.  WORDS are the command's arguments, REDIRECTS
@@ -5810,6 +5927,23 @@ execute_disk_command (WORD_LIST *words, REDIRECT *redirects, char *command_line,
 
   if (command)
     {
+      char *wasm_tool;
+
+      /* Browser PoC: a registered WASM tool stub (see the block comment
+	 above execute_wasm_tool_command) -- run it via the bridge and
+	 return directly, before any of bash's own "found a real
+	 command" bookkeeping below (shell-level adjustment in particular
+	 assumes the process is about to be replaced or exit, neither of
+	 which happens here). */
+      wasm_tool = wasm_tool_stub_name (command);
+      if (wasm_tool)
+	{
+	  result = execute_wasm_tool_command (words, wasm_tool, redirects);
+	  free (wasm_tool);
+	  FREE (command);
+	  return (result);
+	}
+
